// Groovy? Flighty? Soothing?
setcpm(120/4)

const rumble = s("bd")
  .bank("emusp12")
  .fast(4)
  .rumble(100, 3, 1, 20)
  .diode("0.3:0.3")
  .orbit(2)

const kick = s("bd")
  .bank("rolandmc303")
  .distort("0.5:0.6")
  .clip(0.05)
  .fast(4)
  .duck(2)
  .duckattack("0.15")
  .duckdepth(".6")

const snare = s("sd")
  .hpf(10000)
  .beat("0 2 4 6 8 10 12 14 15", 16)
  .velocity(saw.range(0.4,0.7).add(rand.range(0, 0.3)))
  .velocity(rand.range(0.3, 0.6))
  .distort(2)
  .postgain(0.5)

const groove = s("saw")
  .struct("- x x? [x x]")
  .velocity("0 0.3 1 0.8")
  .acidlpf(900)
  .fast(2)
  .postgain(0.6)
  .room(2)
  .octave(1)

const lead = s("supersaw")
  .n("<0 3 2 1>")
  .scale("G:minor")
  .unison(8)
  .off(1/8, x => x.octave(1))
  .velocity("<0.3 0.2 0.3 0.1>")
  .acidlpf(800)
  .hpf(700)
  .fast(16)
  .superimpose(x => x.dry(0).delay(3).room(5))
  .someCyclesBy(0.6, x => x.rev())
  .postgain(slider(0.586,0,1))
  .orbit(2)
  ._pianoroll()


const highhat = s("hh")
  .hpf(9000)
  .fast(16)
  .velocity("0.3 0.5 1")
  .jux(x => x.rev().off(3/16, x => x))

$: stack(
  highhat,
  rumble,
  snare,
  kick,
  groove,
  lead
)
