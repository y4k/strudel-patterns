setcpm(100/4)

const BAR_1_NOTES = `
  0 - - 2
  - 4 - -
  - - 5 -
  - 4 - -
  `

const BAR_2_NOTES = `
  0 - - 0
  - 4 5 -
  - - 4 -
  [5 -] [4 -] [3 -] [2 -]`

const chords = chord("<C Am G F>")
  .s("supersaw")
  .voicing()
  .scale("A:minor")
  .slow(2)
  .postgain(0.8)

const lead = note(slowcat(BAR_1_NOTES, BAR_2_NOTES).add("[0, 2, 4]"))
  .scale("A:minor")
  .fast(1)
  .s("supersaw")
  .unison(10).detune(0.3)
  .orbit(2)
  .adsr("0:1:0.5:0.2")
  .diode(1.3)
  .lpf(2000).lfo({rate:1, sync: "1", depth:1.5})
  .diode(0.3)
  .jux(x => x.early(sine.range2(-0.01, 0.01)))
  .postgain(slider(0.3,0,1,0.1))
  .room(2)

const kick = s("bd*4").bank("tr909").duck(2).duckattack(0.01).duckdepth(1)

const rolling_sub_bass = s("gm_melodic_tom:4")
    .rolling_sub(50, slider(5,0,10,1))
    .orbit(2)
    .phaser(1)
    .delayfeedback(0.6)
    .clip(1)
    .slow(1)
    .lfo({c:"lpf", r:1, sync: "8"})
    .adsr("0:0:.4:0")

const hats = s("<- oh hh oh>*8")
  .bank("tr909")
  .velocity("<0 0.3 0.8 0.6>*8")
  .hpf(4000)

const one = stack(
  chords,
  rolling_sub_bass)

const two = stack(
  one, hats)

const all = stack(
  lead,
  chords,
  kick,
  rolling_sub_bass,
  hats)

$: arrange(
    [8, one],
    [8, two],
    [20, all]
  )
