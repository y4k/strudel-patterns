// Techno testing
setcpm(120/4)

pulse: s("<sd - [sd sd]>")
  .bank("circuitstom")
  .fast(8)
  .hpf(3000)
  .orbit(2)

kick: s("bd:4*4")
  .bank("mc303")
  .lpf(800)
  .postgain(0.7)
  .duck(2)
  .duckattack(0.01)

all(x => x._pianoroll({labels:true}))
  
rumble: s("bd")
  .bank("emusp12")
  .fast(4)
  .room(3)
  .dry(0)
  .lpf(200)
  .delay(1)
  .compressor(10)
  .orbit(2)

clap: s("cp")
  .bank("bossdr110")
  .struct("- x - x x - x? -")
  .hpf(2500)
  .fast(2)
  .postgain(0.5)
  .room(2)
  .delay("<0 2?>")

bassline: note("[c2 -]")
  .s("supersaw")
  .someCyclesBy(0.3, x => x.adsr("<0.001:0.525:0:0.6 0.004:0.259:0:0.6>"))
  .lpf(slider(323,0,500))
  .lpattack(0.004)
  .lpdecay(0.259)
  .unison(3)
  .fast(16)
  .orbit(2)

_moroder: note("C1")
  //.freq(261)
  .s("supersaw")
  .struct("x*16")
  //.adsr("0.001:0.525:0:0.6")
  .lpf(60)
  .lpattack(0.004)
  .lpdecay(0.259)
  .lpsustain(0)
  .lprelease(0.600)
  .unison(0)
