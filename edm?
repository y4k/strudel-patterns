const PATTERN = `<
  x@2 - x
  x - x@2
  x@2 - x@2
  x x@2>*16`

marimba: note("c4")
  .struct(PATTERN)
  .s("gm_marimba:0")
  .lpf(1300)
  .lpenv(-4)
  .postgain(1.8)
  .superimpose(x => x.s("gm_marimba:4"))
  ._pianoroll({labels:true})

